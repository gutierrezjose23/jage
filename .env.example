# Copia este archivo como .env y completa tus propios valores.
# Genera SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development
SECRET_KEY=
DATABASE_URL=mysql+pymysql://jage_app:CAMBIA_ESTA_CLAVE@127.0.0.1:3306/jage?charset=utf8mb4

# HTTP local: false. APP_ENV=production fuerza cookies Secure (requiere HTTPS).
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# MySQL remoto en producción requiere TLS verificado.
# true usa certificados raíz del sistema; MYSQL_SSL_CA indica el CA del proveedor.
MYSQL_SSL=false
MYSQL_SSL_CA=

# null: conexiones breves para serverless. pooled: servidor Flask persistente.
DB_POOL_MODE=null
# Activa solo detrás de un único proxy confiable que limpie X-Forwarded-*.
TRUST_PROXY=false
